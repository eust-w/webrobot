<?xml version="1.0"?>
<robot name="generic_cobot_arm">
  <material name="white"><color rgba="0.92 0.94 0.9 1"/></material>
  <material name="black"><color rgba="0.04 0.05 0.05 1"/></material>
  <link name="base_link"><visual><origin xyz="0 0 0.08"/><geometry><cylinder radius="0.25" length="0.16"/></geometry><material name="black"/></visual></link>
  <link name="right_upper_arm"><visual><origin xyz="0 0 0.22"/><geometry><cylinder radius="0.055" length="0.44"/></geometry><material name="white"/></visual></link>
  <joint name="right_shoulder_pitch_joint" type="revolute"><parent link="base_link"/><child link="right_upper_arm"/><origin xyz="0 0 0.2"/><axis xyz="1 0 0"/><limit lower="-2.8" upper="2.8" effort="10" velocity="3"/></joint>
  <link name="right_forearm"><visual><origin xyz="0 0 0.2"/><geometry><cylinder radius="0.047" length="0.4"/></geometry><material name="white"/></visual></link>
  <joint name="right_elbow_joint" type="revolute"><parent link="right_upper_arm"/><child link="right_forearm"/><origin xyz="0 0 0.42"/><axis xyz="1 0 0"/><limit lower="-2.5" upper="0.3" effort="10" velocity="3"/></joint>
  <link name="right_wrist"><visual><origin xyz="0 0 0.06"/><geometry><box size="0.12 0.1 0.1"/></geometry><material name="black"/></visual></link>
  <joint name="right_wrist_pitch_joint" type="revolute"><parent link="right_forearm"/><child link="right_wrist"/><origin xyz="0 0 0.36"/><axis xyz="1 0 0"/><limit lower="-1.4" upper="1.4" effort="5" velocity="3"/></joint>
</robot>
